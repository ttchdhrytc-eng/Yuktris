{
  "name": "linkedin-browser-worker",
  "version": "1.0.0",
  "description": "Real Playwright browser worker for LinkedIn automation — polls Supabase queue, launches Chromium, executes LinkedIn actions, saves encrypted sessions.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx src/test.ts",
    "test:phase2a": "npm run build && node dist/phase2a.test.js",
    "test:persistent-context": "npm run build && node dist/persistent-context.test.js",
    "test:persistent-context-a2": "npm run build && node dist/persistent-context-a2.test.js",
    "test:auth-ux": "npm run build && node dist/auth-ux.test.js",
    "test:post-auth-runtime": "npm run build && node dist/post-auth-runtime.test.js",
    "test:post-auth-latency": "npm run build && node dist/post-auth-latency.test.js",
    "test:persistent-fast-path": "npm run build && node dist/persistent-fast-path.test.js",
    "test:interactive-challenge": "npm run build && node dist/interactive-challenge.test.js",
    "test:identity-latency": "npm run build && node dist/identity-latency.test.js",
    "test:connection-orchestration": "npm run build && node dist/connection-orchestration.test.js",
    "test:auth-surface-lifecycle": "npm run build && node --test dist/auth-surface-lifecycle.test.js",
    "test:authenticated-identity-state": "npm run build && node --test dist/authenticated-identity-state.test.js",
    "test:v1-authenticated-reuse": "npm run build && node --test dist/v1-authenticated-reuse.test.js",
    "test:restored-bound-identity": "npm run build && node --test dist/restored-bound-identity-contract.test.js",
    "test:fresh-identity-pending": "npm run build && node --test dist/fresh-identity-pending.test.js",
    "test:post-auth-capture": "npm run build && node --test dist/post-auth-capture-continuity.test.js",
    "test:linkedin-v1-stabilization": "npm run build && node --test dist/linkedin-v1-stabilization.test.js",
    "install-browser": "echo 'No local browser needed — using Browserbase'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@types/dotenv": "^6.1.1",
    "dotenv": "^17.4.2",
    "playwright": "^1.49.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
