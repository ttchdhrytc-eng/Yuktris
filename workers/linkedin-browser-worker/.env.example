# ── Required ───────────────────────────────────────────────
# Supabase project URL (same as frontend, but worker uses service role key)
SUPABASE_URL=https://your-project.supabase.co

# Supabase SERVICE ROLE key — NEVER expose to frontend
# Found in: Supabase Dashboard → Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-side encryption secret for LinkedIn session data
# Generate with: openssl rand -base64 32
LINKEDIN_SESSION_ENCRYPTION_KEY=your-32-byte-base64-secret

# ── Browserbase (Required) ──────────────────────────────────
# Browserbase is the cloud browser provider — replaces local Chromium.
# Found in: Browserbase Dashboard → Settings → API Keys
BROWSERBASE_API_KEY=your-browserbase-api-key

# Found in: Browserbase Dashboard → Settings → Projects
BROWSERBASE_PROJECT_ID=your-browserbase-project-id

# ── Worker Identity ─────────────────────────────────────────
# Unique worker identifier (auto-generated if not set)
WORKER_ID=worker-1

# Region label for this worker
WORKER_REGION=us-east-1

# ── Timing (milliseconds) ───────────────────────────────────
# How often to send heartbeat to browser_workers table
WORKER_HEARTBEAT_INTERVAL=15000

# How often to poll the execution queue
QUEUE_POLL_INTERVAL=3000

# ── Timeouts (milliseconds) ────────────────────────────────
# Connection task timeout (10 minutes — user needs time to authenticate)
CONNECTION_TIMEOUT_MS=600000

# Normal action timeout (3 minutes)
ACTION_TIMEOUT_MS=180000

# Test connection timeout (2 minutes)
TEST_CONNECTION_TIMEOUT_MS=120000

# ── HTTP Server ────────────────────────────────────────────
# Port for health/readiness endpoint
WORKER_PORT=3100
